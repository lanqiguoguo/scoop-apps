{
    "version": "1.2.3",
    "description": "一个DNS测速工具，提高您的网络访问速度",
    "homepage": "https://github.com/Kukaina/DnsTools",
    "license": "Unknown",
    "notes": [
        "DnsTools 是一个 DNS 测速与 DNS 污染检测工具",
        "用户数据目录：%LOCALAPPDATA%\\top.xwsclub\\（WebView2 数据，保存主题、缩放、背景等本地存储设置）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "该目录同时包含 WebView2 缓存，体积可能随使用增长",
        "升级或卸载前请先退出 DnsTools，避免 WebView2 数据文件被占用"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/Kukaina/DnsTools/releases/download/DnsTools-v1.2.3/DnsTools_1.2.3_x64-setup.exe#/dl.7z",
            "hash": "524061cde02977c1a8dbe6397a335965bd29857ade7b985e4fa0a3dc44f19582"
        }
    },
    "shortcuts": [
        [
            "DnsTools.exe",
            "DnsTools"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'top.xwsclub'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'top.xwsclub'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "url": "https://github.com/Kukaina/DnsTools/releases",
        "regex": "DnsTools v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://gh-proxy.org/https://github.com/Kukaina/DnsTools/releases/download/DnsTools-v$version/DnsTools_$version_x64-setup.exe#/dl.7z",
        "hash": {
            "mode": "download"
        }
    }
}
