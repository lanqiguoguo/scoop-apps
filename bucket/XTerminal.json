{
    "version": "5.8.6",
    "description": "不仅是强大的SSH工具,更提供本地控制台,以及更多即将推出的开发相关功能,让您专注于创造卓越的代码",
    "homepage": "https://www.terminal.icu/",
    "license": "Freeware",
    "notes": [
        "XTerminal 的用户数据位于 %APPDATA%\\XTerminal\\（连接配置、会话与日志；官方文档说明：数据存储在哪里 → Windows: %APPDATA%/XTerminal）",
        "本包会将该目录迁移并持久化到 Scoop persist（持久化子目录名 data），并在原路径创建 Junction 指向 persist",
        "升级/卸载时数据保留在 persist 中，卸载仅移除 Junction 链接"
    ],
    "architecture": {
        "64bit": {
            "url": "https://cdn-cn.xterminal.cn/downloads/XTerminal-5.8.6-win-x64-installer.exe#/dl.7z",
            "hash": "4f3daeaaba5106ac38c394f223001debb2a7de29bdbed13d3183aa1108e03408",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "XTerminal.exe",
            "XTerminal"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'XTerminal'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "persist": "data",
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'XTerminal'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://api.xterminal.cn/server/electron/version3",
        "jsonpath": "$.windows.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn-cn.xterminal.cn/downloads/XTerminal-$version-win-x64-installer.exe#/dl.7z"
            }
        }
    }
}
