{
    "version": "1.9.2",
    "description": "A free, open-source app store for GitHub releases - browse, discover, and install apps with one click",
    "homepage": "https://github.com/kurikomi-labs/komi-store",
    "license": "Apache-2.0",
    "notes": [
        "GitHub Store 是一个跨平台的 GitHub Releases 应用商店",
        "用户数据目录：%APPDATA%\\Komi-Store\\（偏好设置、Room 数据库 github_store.db、窗口状态）",
        "日志目录：%LOCALAPPDATA%\\Komi-Store\\logs\\",
        "下载缓存目录：%LOCALAPPDATA%\\GithubStore\\Downloads\\",
        "本包会将以上三个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "升级/卸载不会丢失数据库与设置；保存到系统「下载」文件夹的安装包（%USERPROFILE%\\Downloads\\Komi Store Downloads）属于用户文件，不在本包管理范围"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/kurikomi-labs/komi-store/releases/download/v1.9.2/Komi-Store-1.9.2-windows-portable.zip",
            "hash": "afc18b9a68c1ec74438f28990a87b6b35595ec8d8b6a47856de3a68b1aef9a2b",
            "extract_dir": "Komi-Store"
        }
    },
    "bin": "Komi-Store.exe",
    "shortcuts": [
        [
            "Komi-Store.exe",
            "Komi Store"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:APPDATA 'Komi-Store') 'data'",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'Komi-Store') 'localdata'",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'GithubStore\\Downloads') 'downloads'"
    ],
    "persist": [
        "data",
        "localdata",
        "downloads"
    ],
    "post_uninstall": [
        "$sources = @(",
        "    (Join-Path $env:APPDATA 'Komi-Store'),",
        "    (Join-Path $env:LOCALAPPDATA 'Komi-Store'),",
        "    (Join-Path $env:LOCALAPPDATA 'GithubStore\\Downloads')",
        ")",
        "foreach ($source in $sources) {",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/kurikomi-labs/komi-store"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/kurikomi-labs/komi-store/releases/download/v$version/Komi-Store-$version-windows-portable.zip",
                "extract_dir": "Komi-Store"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
