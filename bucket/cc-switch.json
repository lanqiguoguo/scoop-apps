{
    "version": "4.0.8",
    "description": "A desktop All-in-One assistant tool for Claude Code, Codex & Gemini CLI.",
    "homepage": "https://github.com/farion1231/cc-switch",
    "license": "MIT",
    "notes": [
        "CC Switch 是面向 Claude Code、Codex 与 Gemini CLI 的桌面一体化助手工具",
        "用户数据目录 1：%USERPROFILE%\\.cc-switch\\（cc-switch.db、config.json、skills.json、备份与日志）",
        "用户数据目录 2：%LOCALAPPDATA%\\com.ccswitch.desktop\\（WebView2 数据：主题、语言、视图等本地存储及缓存）",
        "本包会将这两个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "升级或卸载前请先退出 CC Switch，避免数据库与 WebView2 数据文件被占用"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/farion1231/cc-switch/releases/download/v4.0.8/CC-Switch-v4.0.8-Windows-Portable.zip",
            "hash": "217e7ab78e620635c06501cc3031ae090381ecaacd005f93c6c9b7e9786bb5a6"
        }
    },
    "shortcuts": [
        [
            "cc-switch.exe",
            "CC-Switch"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'com.ccswitch.desktop') 'data'",
        "& $createJunction (Join-Path $env:USERPROFILE '.cc-switch') 'dotccswitch'"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'com.ccswitch.desktop'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}",
        "$source = Join-Path $env:USERPROFILE '.cc-switch'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "persist": [
        "data",
        "dotccswitch"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows-Portable.zip"
            }
        }
    }
}
