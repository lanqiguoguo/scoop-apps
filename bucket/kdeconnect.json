{
    "version": "26.08-6671",
    "description": "Communications and data transfer between devices over local networks",
    "homepage": "https://kdeconnect.kde.org",
    "license": "GPL-2.0-or-later",
    "notes": [
        "KDE Connect 用于在局域网内实现设备之间的通信与文件传输",
        "用户数据目录：%LOCALAPPDATA%\\kdeconnect\\（config、trusted_devices、设备私钥 privateKey.pem 与证书 certificate.pem、各设备及插件的配置）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "升级或卸载不会丢失设备配对信息；接收的文件默认保存到系统「下载」文件夹，不在本包管理范围"
    ],
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-26.08/windows/kdeconnect-kde-release_26.08-6671-windows-cl-msvc2022-x86_64.7z",
            "hash": "5073778a20ca82c51c24733dce3c239b23c69f5f5c97529acd3fe0d35d5e2b35"
        }
    },
    "bin": "bin\\kdeconnect-cli.exe",
    "shortcuts": [
        [
            "bin\\kdeconnect-indicator.exe",
            "KDE Connect"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'kdeconnect'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "persist": "data",
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'kdeconnect'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "checkver": {
        "script": [
            "$relRes = $(Invoke-WebRequest 'https://cdn.kde.org/ci-builds/network/kdeconnect-kde/?C=M;O=D').Content",
            "$relRes -match 'release-([\\d.]+)'",
            "$major = $Matches.1",
            "$verRes = $(Invoke-WebRequest \"https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-$major/windows/\").Content",
            "$verRes -match \"kdeconnect-kde-release_$major-(\\d+)\"",
            "$build = $Matches.1",
            "\"$major-$build\""
        ],
        "regex": "((?<release>[\\d.]+)-\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-$matchRelease/windows/kdeconnect-kde-release_$version-windows-cl-msvc2022-x86_64.7z"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
