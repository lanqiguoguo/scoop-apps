{
    "version": "1.4.5",
    "description": "A music app developed using Flutter.",
    "homepage": "https://github.com/bb-music/flutter-app",
    "license": "GPL-3.0-only",
    "notes": [
        "bbmusic（哔哔音乐）是一款 Flutter 音乐应用",
        "用户数据目录：%APPDATA%\\com.example\\bbmusic\\（shared_preferences.json 保存设置、收藏、歌单、播放与搜索历史等）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "下载的音乐文件保存在系统下载目录，不纳入 persist 管理",
        "升级或卸载前请先退出 bbmusic，避免数据文件被占用"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/bb-music/flutter-app/releases/download/v1.4.5/bbmusic-windows.zip",
            "hash": "3b7c3fdb5d3b668262bd87a4f8af4b70b1dcc6229df6a5035e17eb34c1a09075"
        }
    },
    "extract_dir": "Release",
    "bin": "bbmusic.exe",
    "shortcuts": [
        [
            "bbmusic.exe",
            "bbmusic"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'com.example\\bbmusic'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'com.example\\bbmusic'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/bb-music/flutter-app/releases/download/v$version/bbmusic-windows.zip"
            }
        }
    }
}
