{
    "version": "0.3.5",
    "description": "High-performance Windows memory optimization tool with Rust core and Python CustomTkinter UI",
    "homepage": "https://github.com/Kiowx/MemCleaner",
    "license": "Apache-2.0",
    "notes": [
        "Configuration is stored in: $persist_dir\\memcleaner",
        "This package creates a Junction from %APPDATA%\\memcleaner to the persist directory; data is kept in persist",
        "To enable autostart, use the settings page in the app",
        "Administrator privileges are required for full memory cleaning capabilities"
    ],
    "url": "https://gh-proxy.org/https://github.com/Kiowx/MemCleaner/releases/download/v0.3.5/MemCleaner.exe",
    "hash": "1a57e679abc290370f66772f8cc7c863691813c02e087dd3295313778b400adf",
    "bin": "MemCleaner.exe",
    "shortcuts": [
        [
            "MemCleaner.exe",
            "MemCleaner"
        ]
    ],
    "persist": "memcleaner",
    "pre_install": [
        "$target = Join-Path $env:APPDATA 'memcleaner'",
        "$source = Join-Path $persist_dir 'memcleaner'",
        "ensure $source",
        "",
        "if (Test-Path $target) {",
        "    $item = Get-Item -LiteralPath $target -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"Existing link left untouched: $target\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"Path exists and is not a directory: $target\"",
        "    }",
        "    if (@(Get-ChildItem -LiteralPath $target -Force).Count -gt 0) {",
        "        & robocopy $target $source /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"Migration failed, keeping the existing directory: $target\"",
        "            return",
        "        }",
        "        $backup = \"$target.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $target -Destination $backup -Force",
        "            Write-Host \"Backed up original directory: $backup\"",
        "        } catch {",
        "            Write-Host \"Cannot rename the existing directory, skipped linking: $target\"",
        "            return",
        "        }",
        "    } else {",
        "        Remove-Item -LiteralPath $target -Force",
        "    }",
        "}",
        "New-Item -Path $target -ItemType Junction -Value $source | Out-Null",
        "Write-Host \"Created junction: $target -> $source\""
    ],
    "uninstaller": {
        "script": [
            "$target = Join-Path $env:APPDATA 'memcleaner'",
            "if (Test-Path $target) {",
            "    $item = Get-Item -LiteralPath $target -Force",
            "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
            "        try { [System.IO.Directory]::Delete($target, $false) } catch { Remove-Item -LiteralPath $target -Force }",
            "        Write-Host \"Removed link, data is kept in persist: $target\"",
            "    }",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://gh-proxy.org/https://github.com/Kiowx/MemCleaner/releases/download/v$version/MemCleaner.exe"
    }
}
