{
    "version": "1.3.5",
    "description": "A powerful tool that turns your Android device into a high-quality wireless microphone for your PC",
    "homepage": "https://github.com/LanRhyme/MicYou",
    "license": "MIT",
    "notes": [
        "MicYou 是一个将 Android 设备变成 PC 无线麦克风的工具",
        "用户数据目录：%LOCALAPPDATA%\\MicYou\\（micyou.conf 配置、plugins 插件、ulunas.onnx 降噪模型、micyou.log 日志）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "升级/卸载不会丢失配置；旧版本遗留的 ~/.micyou 目录会由应用在首次启动时自行迁移"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/LanRhyme/MicYou/releases/download/v1.3.5/MicYou-Win-1.3.5.zip",
            "hash": "77ca39bde88e66fdbfc4ae205553824bb371509b221a08ca4e444def9b5bf202",
            "extract_dir": "MicYou"
        }
    },
    "bin": "MicYou.exe",
    "shortcuts": [
        [
            "MicYou.exe",
            "MicYou"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:LOCALAPPDATA 'MicYou'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "persist": "data",
    "post_uninstall": [
        "$source = Join-Path $env:LOCALAPPDATA 'MicYou'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/LanRhyme/MicYou"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/LanRhyme/MicYou/releases/download/v$version/MicYou-Win-$version.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
