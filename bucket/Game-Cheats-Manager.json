{
    "version": "2.5.1",
    "description": "A tool for managing game cheats.",
    "homepage": "https://github.com/dyang886/Game-Cheats-Manager",
    "license": "MIT",
    "notes": [
        "Game Cheats Manager 是游戏修改器管理器",
        "用户数据目录 1：%APPDATA%\\GCM Settings\\（settings.json 与 db 数据库）",
        "用户数据目录 2：%APPDATA%\\GCM Trainers\\（默认的修改器下载目录，可在应用内更改）",
        "本包会将这两个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "若在应用内把下载目录改为其它路径，该自定义路径不会被本 manifest 接管",
        "FLiNG 修改器自身的设置目录（%USERPROFILE%\\Documents\\FLiNGTrainer、%LOCALAPPDATA%\\FLiNGTrainer）由第三方修改器使用，不在本包管理范围",
        "升级或卸载前请先退出 Game Cheats Manager，避免数据库与下载文件被占用"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/dyang886/Game-Cheats-Manager/releases/download/v2.5.1/Game.Cheats.Manager.Setup.2.5.1.exe",
            "hash": "18b2a3459aeefe989eac264ae253e03a0098b6110d3a238e593ea677fb0ce84d"
        }
    },
    "innosetup": true,
    "bin": "Game Cheats Manager.exe",
    "shortcuts": [
        [
            "Game Cheats Manager.exe",
            "Game Cheats Manager"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:APPDATA 'GCM Settings') 'data'",
        "& $createJunction (Join-Path $env:APPDATA 'GCM Trainers') 'trainers'"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'GCM Settings'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}",
        "$source = Join-Path $env:APPDATA 'GCM Trainers'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": [
        "data",
        "trainers"
    ],
    "checkver": {
        "github": "https://github.com/dyang886/Game-Cheats-Manager"
    },
    "autoupdate": {
        "url": "https://gh-proxy.org/https://github.com/dyang886/Game-Cheats-Manager/releases/download/v$version/Game.Cheats.Manager.Setup.$version.exe",
        "hash": {
            "mode": "download"
        }
    }
}
