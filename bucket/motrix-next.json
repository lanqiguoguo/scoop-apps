{
    "version": "3.9.9",
    "description": "A full-featured download manager — rebuilt from the ground up.",
    "homepage": "https://motrix-next.pages.dev",
    "license": "MIT",
    "notes": [
        "Motrix Next 是一款全功能下载管理器，支持 HTTP/BT/ED2K 等协议",
        "用户数据目录 1：%APPDATA%\\com.motrix.next\\（history.db 下载历史、config.json、download.session、engine\\state、bt、ed2k 等）",
        "用户数据目录 2：%LOCALAPPDATA%\\com.motrix.next\\（engine\\aria2.conf 引擎配置、logs 日志与 WebView2 缓存数据）",
        "本包会将这两个目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "升级/卸载不会丢失下载历史与任务会话；下载的文件本身保存在你设置的下载目录，不在本包管理范围"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.9/MotrixNext_3.9.9_x64-setup.exe#/dl.7z",
            "hash": "93cf1870b1711b642482ddb3f9839ca6dc04b2919992acd8800884dd25ca3377"
        },
        "arm64": {
            "url": "https://gh-proxy.org/https://github.com/AnInsomniacy/motrix-next/releases/download/v3.9.9/MotrixNext_3.9.9_arm64-setup.exe#/dl.7z",
            "hash": "62ce596dfc03787eb42746290468c7a16d67b5b132368761c198cf1fc330ad6d"
        }
    },
    "pre_install": "Remove-Item -Path \"$dir\\`$*\" -Force -Recurse",
    "shortcuts": [
        [
            "motrix-next.exe",
            "Motrix Next"
        ]
    ],
    "post_install": [
        "$createJunction = {",
        "    param($source, $name)",
        "    $target = Join-Path $persist_dir $name",
        "    ensure $target",
        "",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) {",
        "            throw \"配置路径已存在且不是目录：$source\"",
        "        }",
        "",
        "        & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"迁移失败，保留原目录：$source\"",
        "            return",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $source -Destination $backup -Force",
        "            Write-Host \"已备份原配置目录：$backup\"",
        "        } catch {",
        "            Write-Host \"无法重命名原目录：$source\"",
        "            return",
        "        }",
        "    }",
        "",
        "    New-Item -Path $source -ItemType Junction -Value $target | Out-Null",
        "}",
        "",
        "& $createJunction (Join-Path $env:APPDATA 'com.motrix.next') 'data'",
        "& $createJunction (Join-Path $env:LOCALAPPDATA 'com.motrix.next') 'localdata'"
    ],
    "persist": [
        "data",
        "localdata"
    ],
    "post_uninstall": [
        "$sources = @(",
        "    (Join-Path $env:APPDATA 'com.motrix.next'),",
        "    (Join-Path $env:LOCALAPPDATA 'com.motrix.next')",
        ")",
        "foreach ($source in $sources) {",
        "    if (Test-Path $source) {",
        "        $item = Get-Item -LiteralPath $source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "        }",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/AnInsomniacy/motrix-next"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://gh-proxy.org/https://github.com/AnInsomniacy/motrix-next/releases/download/v$version/MotrixNext_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
