{
    "version": "1.0.4",
    "description": "Kimi Code desktop client: Moonshot AI's AI coding agent app with a bundled kimi-code runtime, sharing local configuration with the Kimi Code CLI",
    "homepage": "https://www.kimi.com/code/docs/kimi-code-desktop/getting-started.html",
    "license": "Freeware",
    "notes": [
        "Kimi Code 桌面端是 Moonshot AI 的 AI 编程代理桌面客户端，内置 kimi-code 运行时，与独立安装的 Kimi Code CLI 共享本地配置（系统要求：Windows 10 及以上，64 位）",
        "数据目录：",
        "  - %APPDATA%\\kimi-code-app：桌面壳的 Electron userData（界面状态、浏览器标签、窗口状态等）",
        "      已 Junction 到 persist\\AppData；若该目录已存在，会先整体搬到 persist 并在原位置留下 .backup-<时间戳> 备份",
        "  - %USERPROFILE%\\.kimi-code：KIMI_CODE_HOME 运行时主目录（登录凭据、日志、会话记录，与 Kimi Code CLI 共用）",
        "      已 Junction 到 persist\\kimi-code-home，但仅在目录不存在或为空时接管；已装 CLI、或该目录已有数据时保持原样",
        "应用首次启动会注册 kimi-code:// 深链（HKCU\\Software\\Classes\\kimi-code），卸载时本包会清理指向本包的注册",
        "应用自带自动更新（electron-updater，官方 feed 位于 code.kimi.com）；由 Scoop 管理时建议在应用内关闭自动更新，改用 scoop update kimi-code-desktop 升级",
        "卸载只删除 Junction 链接与 kimi-code:// 注册，persist 数据保留（scoop uninstall -p 才会连数据一起删除）"
    ],
    "architecture": {
        "64bit": {
            "url": "https://code.kimi.com/kimi-code/desktop/binaries/1.0.4/KimiCode-1.0.4-win-x64.exe#/dl.7z",
            "hash": "8dc077263e4f92a80803308a8bc0177d6dfd0aa07fc02197d1850b5f9b975080"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": [
        [
            "Kimi Code.exe",
            "kimi-code-desktop"
        ]
    ],
    "shortcuts": [
        [
            "Kimi Code.exe",
            "Kimi Code"
        ]
    ],
    "post_install": [
        "ensure (Join-Path $persist_dir 'AppData')",
        "ensure (Join-Path $persist_dir 'kimi-code-home')",
        "",
        "$linkAppData = {",
        "    param([string]$Source, [string]$Target)",
        "    if (Test-Path -LiteralPath $Source) {",
        "        $item = Get-Item -LiteralPath $Source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"Already linked, leaving it as is: $Source\"",
        "            return",
        "        }",
        "        if (-not $item.PSIsContainer) { throw \"Path exists and is not a directory: $Source\" }",
        "        & robocopy $Source $Target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        if ($LASTEXITCODE -gt 7) {",
        "            Write-Host \"Copy to persist failed, keeping the existing dir: $Source\"",
        "            return",
        "        }",
        "        $backup = \"$Source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        try {",
        "            Move-Item -LiteralPath $Source -Destination $backup -Force",
        "            Write-Host \"Moved the previous data dir to: $backup\"",
        "        } catch {",
        "            Write-Host \"Cannot rename the existing dir, skipped linking: $Source\"",
        "            return",
        "        }",
        "    }",
        "    New-Item -Path $Source -ItemType Junction -Value $Target | Out-Null",
        "    Write-Host \"Linked app data dir to persist: $Source\"",
        "}",
        "",
        "$linkIfVacant = {",
        "    param([string]$Source, [string]$Target, [string]$Label)",
        "    if (Test-Path -LiteralPath $Source) {",
        "        $item = Get-Item -LiteralPath $Source -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            Write-Host \"$Label is already linked, leaving it as is: $Source\"",
        "            return",
        "        }",
        "        if (@(Get-ChildItem -LiteralPath $Source -Force).Count -gt 0) {",
        "            Write-Host \"$Label already holds data, it stays outside persist: $Source\"",
        "            return",
        "        }",
        "        Remove-Item -LiteralPath $Source -Force -Recurse",
        "    }",
        "    New-Item -Path $Source -ItemType Junction -Value $Target | Out-Null",
        "    Write-Host \"Linked $Label to persist: $Source\"",
        "}",
        "",
        "& $linkAppData (Join-Path $env:APPDATA 'kimi-code-app') (Join-Path $persist_dir 'AppData')",
        "& $linkIfVacant (Join-Path $env:USERPROFILE '.kimi-code') (Join-Path $persist_dir 'kimi-code-home') 'Kimi Code home (.kimi-code)'"
    ],
    "persist": [
        "AppData",
        "kimi-code-home"
    ],
    "post_uninstall": [
        "$removeLink = {",
        "    param([string]$Path)",
        "    if (Test-Path -LiteralPath $Path) {",
        "        $item = Get-Item -LiteralPath $Path -Force",
        "        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "            # Remove-Item -Force can throw a NullReferenceException on junctions in PS 5.1",
        "            try {",
        "                [System.IO.Directory]::Delete($Path)",
        "            } catch {",
        "                Remove-Item -LiteralPath $Path -Force",
        "            }",
        "            Write-Host \"Removed link, data is kept in persist: $Path\"",
        "        }",
        "    }",
        "}",
        "",
        "& $removeLink (Join-Path $env:APPDATA 'kimi-code-app')",
        "",
        "# .kimi-code may be shared with the standalone Kimi Code CLI:",
        "# only remove the link when it points at this package's persist dir",
        "$kimiHome = Join-Path $env:USERPROFILE '.kimi-code'",
        "if (Test-Path -LiteralPath $kimiHome) {",
        "    $item = Get-Item -LiteralPath $kimiHome -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        $target = [string]$item.Target",
        "        if ($target -ieq (Join-Path $persist_dir 'kimi-code-home')) {",
        "            & $removeLink $kimiHome",
        "        } else {",
        "            Write-Host \".kimi-code links elsewhere, leaving it alone: $target\"",
        "        }",
        "    }",
        "}",
        "",
        "# the app registers the kimi-code:// deep link on first launch:",
        "# drop the registration only when it points at this package's install dir",
        "$protoKey = 'HKCU:\\SOFTWARE\\Classes\\kimi-code'",
        "if (Test-Path $protoKey) {",
        "    $cmd = (Get-ItemProperty \"$protoKey\\shell\\open\\command\" -ErrorAction SilentlyContinue).'(default)'",
        "    if (-not $cmd -or $cmd -like '*\\apps\\kimi-code-desktop\\*') {",
        "        Remove-Item $protoKey -Recurse -Force -ErrorAction SilentlyContinue",
        "    } else {",
        "        Write-Host \"kimi-code:// is registered by another copy, leaving it alone: $cmd\"",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://code.kimi.com/kimi-code/desktop/latest.yml",
        "regex": "(?m)^version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://code.kimi.com/kimi-code/desktop/binaries/$version/KimiCode-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
