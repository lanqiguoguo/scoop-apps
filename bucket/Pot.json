{
    "version": "3.0.7",
    "description": "一个跨平台的划词翻译和OCR软件 | A cross-platform software for text translation and recognize",
    "homepage": "https://pot-app.com",
    "license": "GPL-3.0-or-later",
    "notes": [
        "用户配置目录：%APPDATA%\\com.pot-app.desktop\\",
        "  - config.json：翻译/OCR 服务、快捷键、外观等全部设置",
        "  - history.db：翻译历史数据库",
        "  - plugins\\：用户安装的插件",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist（升级/重装不丢失配置）",
        "%LOCALAPPDATA%\\com.pot-app.desktop 仅存放 WebView2 与截图等缓存，不纳入 persist",
        "- https://github.com/ViCrack/scoop-bucket/blob/master/bucket/pot.json"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/pot-app/pot-desktop/releases/download/3.0.7/pot_3.0.7_x64-setup.exe#/dl.7z",
            "hash": "0a6ac5309bfc41234d58cf6615a779c66d167d3a0da5542a0de2ea118fc6bc56",
            "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
        }
    },
    "shortcuts": [
        [
            "pot.exe",
            "Pot"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'com.pot-app.desktop'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'com.pot-app.desktop'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/pot-app/pot-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/pot-app/pot-desktop/releases/download/$version/pot_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
