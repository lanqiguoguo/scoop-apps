{
    "version": "0.2.0",
    "description": "PixShell - 跨平台 SSH / SFTP 桌面客户端 · 终端 · 连接管理 · 文件传输 | Cross-platform SSH/SFTP desktop client for macOS, Windows",
    "homepage": "https://github.com/lyu0805/pixshell",
    "license": "CC-BY-NC-4.0",
    "notes": [
        "PixShell 的用户数据位于 %APPDATA%\\PixShell\\（hosts.json 主机清单、recents.json 快速连接历史、creds.dat 凭据（DPAPI 加密，仅当前 Windows 用户可解）、agent_token、logs 日志、webview2 缓存）",
        "本包会将该目录迁移并持久化到 Scoop persist（持久化子目录名 data），并在原路径创建 Junction 指向 persist",
        "%USERPROFILE%\\.ssh（known_hosts、私钥）为用户级 OpenSSH 配置，本包不会接管",
        "升级/卸载时数据保留在 persist 中，卸载仅移除 Junction 链接"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gh-proxy.org/https://github.com/lyu0805/pixshell/releases/download/v0.2.0/PixShell-0.2.0-win-x64.zip",
            "hash": "e33504d1b93348038e39848d99007e69acebe8fe886d2af0b51705ce0373ebd0"
        }
    },
    "shortcuts": [
        [
            "PixShell.exe",
            "PixShell"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'PixShell'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "persist": "data",
    "post_uninstall": [
        "$source = Join-Path $env:APPDATA 'PixShell'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        try { [System.IO.Directory]::Delete($source, $false) } catch { Remove-Item -LiteralPath $source -Force }",
        "    }",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/lyu0805/pixshell/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v(\\d+\\.\\d+\\.\\d+(?:[-.].+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.org/https://github.com/lyu0805/pixshell/releases/download/v$version/PixShell-$version-win-x64.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
